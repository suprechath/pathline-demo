DATABASE_URL="postgresql://pathline:pathline@localhost:5432/pathline?schema=public"
# Assayline LIMS — separate schema in the same Postgres, keeping the two
# systems decoupled (own client, own connection). Change the DB if you prefer.
LIMS_DATABASE_URL="postgresql://pathline:pathline@localhost:5432/pathline?schema=lims"
BATCHLINE_API_KEY="local-demo-key"
# Base URL the Batchline simulator uses to POST inbound webhooks back to this app.
BASE_URL="http://localhost:3000"
