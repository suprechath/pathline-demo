// Assayline LIMS — Quality (IPC hold points)
// PostgreSQL schema (Prisma) — STANDALONE
//
// This schema is intentionally SELF-CONTAINED. It only holds data pushed in
// from Batchline EBR (the in-process test requests) plus the results the lab
// records against them. It has NO foreign keys or shared enums with the
// Pathline ERP schema — batch / stage / material are stored as plain string
// identifiers exactly as they arrive on the Batchline payload, never as
// relations. Run it against its own database/schema (e.g. a separate
// DATABASE_URL or a dedicated Postgres schema) so the two systems stay
// decoupled, mirroring the real EBR → LIMS → EBR handshake.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/lims-client"
}

datasource db {
  provider = "postgresql"
  url      = env("LIMS_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

// Lifecycle of a hold point, from EBR request to disposition.
enum HoldStatus {
  PENDING // request received from EBR, sample not yet in the lab
  IN_TEST // sample received, testing in progress
  AWAITING_RESULT // ready for the analyst to enter a value
  RELEASED // pass recorded and returned to EBR — next step unblocked
  FAILED // out-of-spec recorded and returned to EBR — batch held
}

// How an acceptance limit is evaluated.
enum LimitType {
  MAX // value must be ≤ upper
  MIN // value must be ≥ lower
  RANGE // lower ≤ value ≤ upper
}

// Computed verdict of a recorded result against its specification.
enum ResultVerdict {
  PASS
  OOS // out of specification
}

// ─────────────────────────────────────────────────────────────
// QcSpecification
//   The acceptance criteria for a test. Copied from the Batchline
//   payload (or a LIMS-local master) — not linked to any ERP material.
// ─────────────────────────────────────────────────────────────
model QcSpecification {
  id        String    @id @default(cuid())
  code      String    @unique // e.g. "TM-BU-007" method/spec reference
  testName  String // e.g. "Blend Uniformity (RSD)"
  parameter String // e.g. "RSD of 10 sample locations"
  limitType LimitType
  lower     Decimal?  @db.Decimal(15, 6) // used by MIN / RANGE
  upper     Decimal?  @db.Decimal(15, 6) // used by MAX / RANGE
  unit      String    @default("") // "%", "" for unitless, etc.
  limitText String // human-readable, e.g. "RSD ≤ 5.0 %"

  holdPoints HoldPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("qc_specifications")
}

// ─────────────────────────────────────────────────────────────
// HoldPoint
//   One in-process control gate, created when Batchline EBR requests a
//   test at a hold point. All batch/stage context is stored as strings
//   straight off the payload — deliberately NOT a relation to the ERP.
// ─────────────────────────────────────────────────────────────
model HoldPoint {
  id       String @id @default(cuid())
  sampleId String @unique // LIMS-assigned sample id, e.g. "IPC-26-0431"

  // --- context received from Batchline (opaque strings, no ERP FK) ---
  batchId       String // EBR batch id, e.g. "PARA-BLEND_9"
  stageName     String // e.g. "Blending"
  gateStep      String? // what the result gates, e.g. "Discharge blend"
  ebrRequestRef String? // EBR-side request/message id for the handshake
  requestedAt   DateTime @default(now())

  status HoldStatus @default(PENDING)

  // --- specification (relation is internal to LIMS only) ---
  specificationId String
  specification   QcSpecification @relation(fields: [specificationId], references: [id], onDelete: Restrict)

  results QcResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([status])
  @@map("hold_points")
}

// ─────────────────────────────────────────────────────────────
// QcResult
//   A value recorded by the lab against a hold point. On record, the
//   verdict is computed and the outcome is pushed back to Batchline EBR;
//   dispositionSentAt / ebrResponseRef capture that return leg.
// ─────────────────────────────────────────────────────────────
model QcResult {
  id            String        @id @default(cuid())
  measuredName  String // e.g. "Relative std. deviation"
  measuredValue Decimal       @db.Decimal(15, 6)
  verdict       ResultVerdict
  recordedBy    String? // analyst name/id captured at entry
  recordedAt    DateTime      @default(now())

  // --- return leg to Batchline EBR ---
  dispositionSentAt DateTime? // when the pass/fail was returned to EBR
  ebrResponseRef    String? // EBR-side ack id for the returned result

  holdPointId String
  holdPoint   HoldPoint @relation(fields: [holdPointId], references: [id], onDelete: Cascade)

  @@index([holdPointId])
  @@map("qc_results")
}
